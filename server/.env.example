# Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=True

# Database
DATABASE_URL=sqlite:///./whatisit.db

# LLM Settings (Modular - Easy to swap!)
LLM_PROVIDER=ollama
LLM_MODEL=llama3.2
LLM_BASE_URL=http://localhost:11434
LLM_TEMPERATURE=0.3

# Embedding Settings (Modular)
EMBEDDING_PROVIDER=sentence-transformers
EMBEDDING_MODEL=all-MiniLM-L6-v2
# Alternative: all-mpnet-base-v2

# Game Settings
MAX_GUESSES=8
SIMILARITY_THRESHOLD_WIN=0.90

# Reddit Settings
SUBREDDIT=whatisthisthing
MIN_UPVOTES=10
MAX_POSTS_PER_SCRAPE=100
