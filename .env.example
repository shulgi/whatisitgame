# Vercel Postgres (automatically set by Vercel)
POSTGRES_URL=
POSTGRES_PRISMA_URL=
POSTGRES_URL_NON_POOLING=
POSTGRES_USER=
POSTGRES_HOST=
POSTGRES_PASSWORD=
POSTGRES_DATABASE=

# ============================================================================
# Cloud LLM APIs (for curation - choose ONE)
# All are FREE with generous limits!
# ============================================================================

# Option 1: Groq (RECOMMENDED - fastest, best quality)
# Get free key at: https://console.groq.com/keys
# Free tier: 14,400 requests/day
GROQ_API_KEY=

# Option 2: Hugging Face (good alternative)
# Get free key at: https://huggingface.co/settings/tokens
# Also used for embeddings (required for gameplay)
HUGGINGFACE_API_KEY=

# Option 3: Local Ollama (optional fallback)
# Only if you want to run LLM locally
# Install: https://ollama.com
LLM_MODEL=llama3.2
